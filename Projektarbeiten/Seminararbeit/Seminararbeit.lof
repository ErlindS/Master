\contentsline {figure}{\numberline {8}{\ignorespaces Abbildung der SYCL-Ausführungshierarchie auf GPU und CPU}}{9}{figure.caption.14}%
\contentsline {figure}{\numberline {9}{\ignorespaces Übersetzung und Ausführung. Der Gerätecode liegt als Zwischendarstellung vor und wird erst beim ersten Start für das gewählte Gerät übersetzt}}{9}{figure.caption.15}%
\contentsline {figure}{\numberline {10}{\ignorespaces Synchrone und asynchrone Fehler. Der synchrone Fehler wird beim Einreichen gemeldet, der asynchrone erst, wenn der Host auf das Gerät wartet}}{10}{figure.caption.16}%
