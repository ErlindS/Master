                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;---\nconfig:\n  theme: neutral\n---\nsequenceDiagram\n  participant H as Host\n  participant G as Gerät\n  H-&gt;&gt;G: Kernel 1 einreichen\n  activate G\n  Note over G: Kernel 1 läuft, Fehler tritt auf\n  H-xH: Kernel 2 einreichen (ungültige Work-Group)\n  Note left of H: synchron: Ausnahme sofort\n  H-&gt;&gt;H: weitere Host-Arbeit\n  deactivate G\n  H-&gt;&gt;G: wait_and_throw()\n  G--&gt;&gt;H: gesammelter Fehler an Async Handler\n  Note over H,G: asynchron: Fehler erst beim Warten sichtbar\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="N5X2PETXQ-RJ7cR8ktCX-93">
                    <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
                        <mxGeometry as="geometry"/>
                    </mxCell>
